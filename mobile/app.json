{
  "expo": {
    "name": "Feria del Libro",
    "slug": "feria-del-libro",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/feria-app-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [["expo-camera", { "cameraPermission": "Permití usar la cámara para escanear el ISBN de un libro.", "recordAudioAndroid": false }]],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.exor203.feriadellibro",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0B3F55",
        "foregroundImage": "./assets/feria-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/feria-app-icon.png"
    }
  }
}
