# Configuración PÚBLICA de la aplicación web registrada en Firebase.
# Copiar a .env y completar localmente. No usar claves de Gemini ni cuentas de servicio.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Elegir un modelo de texto disponible en el nivel gratuito de Gemini Developer API.
EXPO_PUBLIC_GEMINI_MODEL=

# Alternativa de prueba con servidor local; completar solo para desarrollo.
EXPO_PUBLIC_ASSISTANT_MODE=local
EXPO_PUBLIC_ASSISTANT_URL=
EXPO_PUBLIC_LOCAL_CHAT_TOKEN=
